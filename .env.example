# Runtime
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
DATA_DIR=./data
# Public root URL exposed to buyers and callbacks (leave empty until /setup or set to your real HTTPS origin)
PUBLIC_BASE_URL=

# Optional one-time token required by POST /admin-api/setup in production.
# If left empty in production, a random token is written to DATA_DIR/.setup-token (0600).
SETUP_TOKEN=

# Optional. Leave empty to generate DATA_DIR/.master-key on first startup.
# If supplied by a secret manager, generate it with: openssl rand -base64 32
# Never change it after encrypted credentials have been saved.
APP_MASTER_KEY=

# Keep disabled unless callback receivers are intentionally on a private network.
ALLOW_PRIVATE_CALLBACKS=false

# Set to true when deployed behind a trusted local/container reverse proxy (Nginx / Caddy / 1Panel).
TRUST_PROXY=false
# Optional comma-separated proxy IPs/CIDRs allowed to supply X-Forwarded-* headers (defaults to private/loopback ranges).
TRUSTED_PROXY_CIDRS=
# Set to true ONLY when origin firewall restricts inbound traffic exclusively to Cloudflare IP ranges.
TRUST_CLOUDFLARE=false
